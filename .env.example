# Optional model provider keys for the web app's agent route.
# Without these, the UI still works in mock mode.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

GEMINI_API_KEY=
GOOGLE_MODEL=gemini-3.1-flash-lite
GOOGLE_BACKUP_MODEL=gemma-4-31b-it
GOOGLE_LAST_RESORT_MODEL=gemini-2.5-flash-lite

GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3-32b

# Optional GitHub token for cloning private repositories in the local MVP.
# The production plan uses a GitHub App instead.
GITHUB_TOKEN=

# GitHub App credentials for installation-token based repository access.
GITHUB_APP_ID=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_PRIVATE_KEY_PATH=.secrets/github-app-private-key.pem
GITHUB_APP_WEBHOOK_SECRET=
GITHUB_APP_SLUG=
GITHUB_APP_INSTALL_URL=https://github.com/apps/YOUR_APP_SLUG/installations/new

# Local daemon defaults.
DAEMON_PORT=4317
WORKSPACE_ROOT=
