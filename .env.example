# Optional model provider keys for the web app's agent route.
# Without these, the UI still works in mock mode.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

GEMINI_API_KEY=
GOOGLE_MODEL=gemini-3-flash-preview
GOOGLE_MODEL_CANDIDATES=gemini-3-flash-preview,gemini-3.1-flash-lite,gemma-4-31b-it,gemma-4-26b-a4b-it,gemini-2.5-flash,gemini-2.5-flash-lite
GOOGLE_MODEL_RETRIES=2
GOOGLE_BACKUP_MODEL=
GOOGLE_LAST_RESORT_MODEL=

GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3-32b

# Optional small model override for GitHub auto-mode intent classification.
# If omitted, auto mode uses the selected provider/model, with a conservative fallback.
GITHUB_TASK_MODE_MODEL=
OPENAI_TASK_MODE_MODEL=
ANTHROPIC_TASK_MODE_MODEL=
GOOGLE_TASK_MODE_MODEL=
GROQ_TASK_MODE_MODEL=

# Optional reviewer model override for the GitHub PR quality gate.
GITHUB_REVIEW_MODEL=
OPENAI_REVIEW_MODEL=
ANTHROPIC_REVIEW_MODEL=
GOOGLE_REVIEW_MODEL=
GROQ_REVIEW_MODEL=

# Optional repository-agent checkpoint controls.
GITHUB_WRITE_MAX_TOOL_ROUNDS=18
GITHUB_REVIEW_REPAIR_ATTEMPTS=2
GITHUB_REVIEW_REPAIR_TOOL_ROUNDS=12

# Optional GitHub token for cloning private repositories in the local MVP.
# The production plan uses a GitHub App instead.
GITHUB_TOKEN=

# GitHub App credentials for installation-token based repository access.
GITHUB_APP_ID=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_PRIVATE_KEY_PATH=.secrets/github-app-private-key.pem
GITHUB_APP_WEBHOOK_SECRET=
GITHUB_APP_SLUG=
GITHUB_APP_INSTALL_URL=https://github.com/apps/YOUR_APP_SLUG/installations/new

# Local daemon defaults.
DAEMON_PORT=4317
WORKSPACE_ROOT=
