# Optional model provider keys for the web app's agent route.
# Without these, the UI still works in mock mode.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

GEMINI_API_KEY=
GOOGLE_MODEL=gemini-3-flash-preview

GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3-32b

# Optional GitHub token for cloning private repositories in the local MVP.
# The production plan uses a GitHub App instead.
GITHUB_TOKEN=

# Local daemon defaults.
DAEMON_PORT=4317
WORKSPACE_ROOT=
